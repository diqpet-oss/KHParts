<div class="container">
  {%- if cart.item_count > 0 -%}
    <div class="cart-layout">
      <div>
        <h1 style="margin-bottom:24px;">Your cart</h1>
        <div class="cart-lines">
          {%- for item in cart.items -%}
            <div class="cart-line">
              <div class="cart-line__media">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 180 }}"
                    alt="{{ item.title | escape }}"
                    width="90"
                    height="90"
                    loading="lazy">
                {%- endif -%}
              </div>
              <div>
                <div class="cart-line__title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </div>
                {%- if item.variant.title != 'Default Title' -%}
                  <div class="cart-line__meta">{{ item.variant.title }}</div>
                {%- endif -%}
                <div class="cart-line__meta">{{ item.final_line_price | money }}</div>
                <button
                  type="button"
                  class="cart-line__remove"
                  data-line-remove="{{ item.key }}">Remove</button>
              </div>
              <form action="{{ routes.cart_change_url }}" method="post">
                <input type="hidden" name="id" value="{{ item.key }}">
                <div class="cart-line__qty">
                  <input
                    type="number"
                    name="quantity"
                    value="{{ item.quantity }}"
                    min="1"
                    max="99"
                    aria-label="Quantity">
                </div>
              </form>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <aside class="cart-summary">
        <h2 style="font-size:1.2rem;">Summary</h2>
        <div class="cart-summary__row">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-summary__row">
          <span>Shipping</span>
          <span>Calculated at checkout</span>
        </div>
        <div class="cart-summary__row cart-summary__row--total">
          <span>Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <a href="{{ routes.checkout_url }}" class="btn btn--accent btn--full" style="margin-top:16px;">Checkout</a>
        <p style="font-size:.8rem;color:var(--color-text-light);margin-top:12px;">
          Fitment guaranteed — if a part doesn't fit, we'll make it right.
        </p>
      </aside>
    </div>
  {%- else -%}
    <div class="empty">
      <h1 style="font-size:1.6rem;">Your cart is empty</h1>
      <p>Browse verified parts for your Hyundai or Kia.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent" style="margin-top:16px;">Shop all parts</a>
    </div>
  {%- endif -%}
</div>

<script>
  document.querySelectorAll('[data-line-remove]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const form = document.createElement('form');
      form.method = 'post';
      form.action = window.KHP.routes.cart_change;
      const id = document.createElement('input');
      id.type = 'hidden';
      id.name = 'id';
      id.value = btn.dataset.lineRemove;
      const qty = document.createElement('input');
      qty.type = 'hidden';
      qty.name = 'quantity';
      qty.value = '0';
      form.appendChild(id);
      form.appendChild(qty);
      document.body.appendChild(form);
      form.submit();
    });
  });
</script>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}
