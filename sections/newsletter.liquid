<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="fitment" style="text-align:center;background:var(--color-accent-soft);border-color:color-mix(in srgb, var(--color-accent) 20%, transparent);">
      <h2 class="section__title">{{ section.settings.title }}</h2>
      <p class="section__subtitle" style="max-width:520px;margin:0 auto 24px;">{{ section.settings.text }}</p>
      <div style="display:flex;justify-content:center;">
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter">
            <input
              type="email"
              name="contact[email]"
              placeholder="Email address"
              aria-label="Email address"
              required>
            <button type="submit" class="btn btn--primary">{{ section.settings.button_label }}</button>
          </div>
          <p class="form-status" data-newsletter-status style="display:none;"></p>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get the weekly fault report"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "One email a week: common Hyundai/Kia faults, fixes and member-only pricing."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
