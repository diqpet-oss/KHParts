{%- liquid
  assign related_collection = product.collections | first
  assign all_related = related_collection.products
-%}
{%- if section.settings.heading != blank and all_related.size > 1 -%}
  <section class="section">
    <div class="container">
      <h2 class="section__title" style="text-align:center;">{{ section.settings.heading }}</h2>
      <div class="product-grid" style="--products-per-row: 4;margin-top:32px;">
        {%- for related in all_related limit: 4 -%}
          {%- unless related.id == product.id -%}
            {% render 'product-card', product: related %}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also need"
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
