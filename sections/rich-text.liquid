<section class="section">
  <div class="container">
    <div class="section__header">
      {%- if section.settings.eyebrow != blank -%}
        <p style="text-transform:uppercase;letter-spacing:.12em;font-size:.8rem;font-weight:700;color:var(--color-primary);margin-bottom:10px;">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
      <div class="section__subtitle" style="line-height:1.75;">{{ section.settings.text }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Parts tested where it matters"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We don't list a part until it's been fitted, tested and compared against the OEM unit on a real car. That's why our fitment data is trustworthy — and why customers come back.</p>"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
