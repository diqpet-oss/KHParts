<div class="container">
  <div class="search-bar">
    <h1 style="text-align:center;font-size:1.8rem;">Search parts</h1>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Try 'Sportage control arm' or OEM part number"
        aria-label="Search">
      <button type="submit" class="btn btn--primary">Search</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results.size > 0 -%}
      <p class="collection-count" style="margin:24px 0;">
        {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"
      </p>
      <div class="product-grid" style="--products-per-row: {{ section.settings.products_per_row }};">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <a href="{{ item.url }}" class="product-card">
              <div class="product-card__body">
                <span class="product-card__fit">{% render 'icon', name: 'check' %} {{ item.object_type | capitalize }}</span>
                <div class="product-card__title">{{ item.title }}</div>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty">
        <p>No results for "{{ search.terms }}". Try a different keyword or OEM part number.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline" style="margin-top:12px;">Browse all parts</a>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "select",
      "id": "products_per_row",
      "label": "Products per row",
      "options": [
        {"value": "2", "label": "2"},
        {"value": "3", "label": "3"},
        {"value": "4", "label": "4"}
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Search"
    }
  ]
}
{% endschema %}
