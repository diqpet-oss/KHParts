{% form 'storefront_password', class: 'password-form' %}
  <input
    type="password"
    name="password"
    placeholder="Enter password"
    aria-label="Store password"
    autocomplete="current-password">
  <button type="submit" class="btn btn--accent">Enter</button>
{% endform %}

{%- if form.errors -%}
  <p style="color:#fecaca;margin-top:12px;">{{ form.errors.translated }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Password",
  "settings": [],
  "presets": [
    {
      "name": "Password"
    }
  ]
}
{% endschema %}
