<section class="section" style="background:color-mix(in srgb, var(--color-bg) 96%, var(--color-primary) 4%);">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">{{ section.settings.title }}</h2>
      <p class="section__subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="video-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.video_url | default: '#' }}"
          class="video-card"
          data-video-open="{{ block.settings.video_url | default: '' | escape }}"
          {{ block.shopify_attributes }}>
          <div class="video-card__media">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="800"
                height="450">
            {%- else -%}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#64748b;">Video</div>
            {%- endif -%}
            <div class="video-card__play"><span>{% render 'icon', name: 'play' %}</span></div>
          </div>
          <div class="video-card__body">
            <div class="video-card__title">{{ block.settings.title }}</div>
            {%- if block.settings.meta != blank -%}
              <div class="video-card__meta">{{ block.settings.meta }}</div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div style="text-align:center;margin-top:36px;">
        <a href="{{ section.settings.button_link }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "From our workshop"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real installs, real faults, real fixes. Watch before you buy."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Watch more on YouTube"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kia Sportage control arm replacement"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta line",
          "default": "14 min · Install guide"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "default": "https://www.youtube.com/watch?v=example"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Video gallery",
      "blocks": [
        {
          "type": "video",
          "settings": {
            "title": "Kia Sportage control arm replacement",
            "meta": "14 min · Install guide"
          }
        },
        {
          "type": "video",
          "settings": {
            "title": "Hyundai Tucson — top 5 common faults",
            "meta": "8 min · Diagnostics"
          }
        },
        {
          "type": "video",
          "settings": {
            "title": "Brake pads: OEM vs our aftermarket test",
            "meta": "11 min · Comparison"
          }
        }
      ]
    }
  ]
}
{% endschema %}
