[
  {
    "name": "theme_info",
    "theme_name": "KiaHyundai Parts",
    "theme_version": "1.0.0",
    "theme_author": "PartsCo",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "KHParts"
      },
      {
        "type": "textarea",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "Premium replacement parts for Hyundai & Kia"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#0b4a8b"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color",
        "default": "#f15a24"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#111827"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "select",
        "id": "logo_width",
        "label": "Logo width",
        "options": [
          {"value": "80px", "label": "Small"},
          {"value": "120px", "label": "Medium"},
          {"value": "160px", "label": "Large"}
        ],
        "default": "120px"
      }
    ]
  },
  {
    "name": "Social links",
    "settings": [
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_telegram",
        "label": "Telegram URL"
      },
      {
        "type": "url",
        "id": "social_whatsapp",
        "label": "WhatsApp URL"
      }
    ]
  },
  {
    "name": "Fitment checker",
    "settings": [
      {
        "type": "text",
        "id": "fitment_title",
        "label": "Section title",
        "default": "Is this part right for your car?"
      },
      {
        "type": "text",
        "id": "fitment_subtitle",
        "label": "Subtitle",
        "default": "Enter your vehicle details to check compatibility before you buy."
      },
      {
        "type": "text",
        "id": "fitment_button_label",
        "label": "Button label",
        "default": "Check compatibility"
      },
      {
        "type": "textarea",
        "id": "fitment_note",
        "label": "Helper note",
        "default": "Fitment data is based on OEM part numbers. Always confirm against your vehicle VIN or production date."
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "select",
        "id": "products_per_row",
        "label": "Products per row (desktop)",
        "options": [
          {"value": "2", "label": "2"},
          {"value": "3", "label": "3"},
          {"value": "4", "label": "4"}
        ],
        "default": "4"
      },
      {
        "type": "text",
        "id": "product_card_badge",
        "label": "Badge text",
        "default": "Verified Fit"
      }
    ]
  },
  {
    "name": "Checkout",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_checkout_branding",
        "label": "Show brand name at checkout",
        "default": true
      }
    ]
  }
]
