{%- comment -%}
  Product card. Expects `product` in scope.
{%- endcomment -%}
{%- liquid
  assign card_image = product.featured_image
  assign price = product.price | money
  assign compare = product.compare_at_price
-%}
<article class="product-card">
  <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">
    {%- if card_image -%}
      <img
        src="{{ card_image | image_url: width: 600 }}"
        alt="{{ card_image.alt | escape | default: product.title | escape }}"
        width="600"
        height="600"
        loading="lazy">
    {%- else -%}
      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#9ca3af;font-size:3rem;">🔧</div>
    {%- endif -%}
    {%- if settings.product_card_badge != blank -%}
      <span class="product-card__badge">{{ settings.product_card_badge }}</span>
    {%- endif -%}
  </a>
  <div class="product-card__body">
    <span class="product-card__fit">
      {% render 'icon', name: 'check' %}
      Fitment verified
    </span>
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    <div class="product-card__price">
      {{ price }}
      {%- if compare > price -%}
        <s>{{ compare | money }}</s>
      {%- endif -%}
    </div>
  </div>
</article>
