{%- liquid
  assign favicon = settings.favicon
  if favicon == blank
    assign favicon = settings.logo
  endif
-%}
{%- if favicon -%}
  <link rel="icon" type="image/png" href="{{ favicon | image_url: width: 64, height: 64 }}">
  <link rel="apple-touch-icon" href="{{ favicon | image_url: width: 180, height: 180 }}">
{%- else -%}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔧</text></svg>">
{%- endif -%}
