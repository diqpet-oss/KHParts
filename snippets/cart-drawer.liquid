<div class="overlay" data-overlay></div>
<aside class="cart-drawer" data-cart-drawer role="dialog" aria-label="Shopping cart">
  <div class="cart-drawer__head">
    <span class="cart-drawer__title">Your cart</span>
    <button type="button" class="cart-drawer__close" data-cart-close aria-label="Close cart">&#10005;</button>
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__items">
      {%- for item in cart.items -%}
        <div class="cart-drawer__line">
          {%- if item.image -%}
            <img
              src="{{ item.image | image_url: width: 128 }}"
              alt="{{ item.title | escape }}"
              loading="lazy"
              width="64"
              height="64">
          {%- endif -%}
          <div>
            <div class="cart-drawer__line-title">{{ item.product.title }}</div>
            <div class="cart-drawer__line-meta">
              {{ item.quantity }} &times; {{ item.final_line_price | money }}
              {%- if item.variant.title != 'Default Title' %} &middot; {{ item.variant.title }}{% endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="cart-drawer__items">
      <p style="color:var(--color-text-light);text-align:center;padding:40px 0;">
        Your cart is empty. Browse parts by vehicle below.
      </p>
    </div>
  {%- endif -%}

  <div class="cart-drawer__foot">
    <div class="cart-summary__row cart-summary__row--total">
      <span>Subtotal</span>
      <span>{{ cart.total_price | money }}</span>
    </div>
    <p style="font-size:.82rem;color:var(--color-text-light);margin:8px 0 16px;">
      Shipping and taxes calculated at checkout.
    </p>
    <a href="{{ routes.cart_url }}" class="btn btn--outline btn--full" style="margin-bottom:10px;">View cart</a>
    <a href="{{ routes.checkout_url }}" class="btn btn--accent btn--full">Checkout</a>
  </div>
</aside>
